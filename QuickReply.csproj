<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>QuickReply</AssemblyName>
    <RootNamespace>QuickReply</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>QuickReply.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- DPI lo maneja el manifest (WPF lo lee de ahí); silenciamos el aviso de WinForms. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Para una build portable de un solo archivo:  dotnet publish -c Release -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fuente Manrope embebida (estática, por peso) -->
    <Resource Include="Resources\Fonts\Manrope-Regular.ttf" />
    <Resource Include="Resources\Fonts\Manrope-Medium.ttf" />
    <Resource Include="Resources\Fonts\Manrope-SemiBold.ttf" />
    <Resource Include="Resources\Fonts\Manrope-Bold.ttf" />
    <Resource Include="Resources\Fonts\Manrope-ExtraBold.ttf" />
  </ItemGroup>

</Project>
