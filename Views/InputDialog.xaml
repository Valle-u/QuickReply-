<Window x:Class="QuickReply.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickReply" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Background="{StaticResource BrushBg}">
    <Grid Margin="22" TextElement.Foreground="{StaticResource BrushText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{StaticResource BrushText}" FontWeight="SemiBold" />

        <TextBox x:Name="Input" Grid.Row="1" Height="36" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" MinWidth="100" Click="Cancel_Click" />
            <Button Content="Agregar" MinWidth="120" Margin="0" Style="{StaticResource PrimaryButton}"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
