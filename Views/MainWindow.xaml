<Window x:Class="QuickReply.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickReply — Configuración"
        Width="940" Height="660" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Background="{StaticResource BrushBg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="22,18,22,16" TextElement.Foreground="{StaticResource BrushText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / brand -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource BrushOnline}" VerticalAlignment="Center" />
                <TextBlock Text="QuickReply" FontSize="19" FontWeight="Bold" Foreground="White"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border Width="1" Height="16" Background="{StaticResource BrushBorder}" Margin="13,1,0,0" />
                <TextBlock Text="Respuestas rápidas" Foreground="{StaticResource BrushMuted}"
                           FontSize="12.5" Margin="13,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,0,0,16" />
        </StackPanel>

        <!-- Barra de herramientas -->
        <WrapPanel x:Name="Toolbar" Grid.Row="1" Margin="0,0,0,8">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
            </WrapPanel.Resources>
            <Button Click="New_Click" ToolTip="Crear un texto nuevo">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoNew}" />
                    <TextBlock Text="Nuevo texto" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="AddCategory_Click" ToolTip="Crear una categoría nueva">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTag}" />
                    <TextBlock Text="Nueva categoría" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="DeleteCategory_Click" ToolTip="Eliminar una categoría" Width="40" Padding="0">
                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTagMinus}" />
            </Button>
            <Border Width="1" Height="24" Margin="4,6,12,6" Background="{StaticResource BrushBorder}" />
            <Button Click="Duplicate_Click" ToolTip="Duplicar el texto seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoDuplicate}" />
                    <TextBlock Text="Duplicar" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="Delete_Click" ToolTip="Eliminar el texto seleccionado">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoDelete}" />
                    <TextBlock Text="Eliminar" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border Width="1" Height="24" Margin="4,6,12,6" Background="{StaticResource BrushBorder}" />
            <Grid Margin="0,0,8,8">
                <ToggleButton x:Name="MoreButton" Style="{StaticResource ToolbarToggle}" ToolTip="Más acciones">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Más" VerticalAlignment="Center" />
                        <Path Data="{StaticResource IcoChevron}" Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Width="14" Height="14" Stretch="None"
                              VerticalAlignment="Center" Margin="7,1,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom"
                       VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" Focusable="False"
                       IsOpen="{Binding IsChecked, ElementName=MoreButton, Mode=TwoWay}">
                    <Grid Margin="8">
                        <Border Style="{StaticResource CardShadow}" />
                        <Border Style="{StaticResource Card}" Background="{StaticResource BrushCard2}" MinWidth="195">
                            <StackPanel Margin="6">
                                <Button Style="{StaticResource MenuItemButton}" Click="Import_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoImport}" />
                                        <TextBlock Text="Importar" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Click="Export_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoExport}" />
                                        <TextBlock Text="Exportar" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Click="OpenFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFolder}" />
                                        <TextBlock Text="Carpeta" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="6,5" />
                                <Button Style="{StaticResource MenuItemButton}" Click="Options_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoOptions}" />
                                        <TextBlock Text="Opciones" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </WrapPanel>

        <!-- Cuerpo: lista + editor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo -->
            <Grid Grid.Column="0">
                <Border Style="{StaticResource CardShadow}" />
                <Border Style="{StaticResource Card}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="TUS TEXTOS" Style="{StaticResource SectionTitle}" FontSize="12" />
                        <Border Grid.Row="1" Height="1" Background="{StaticResource BrushBorder}" Margin="0,10,0,12" />

                        <Grid Grid.Row="2" Margin="0,0,0,4">
                            <TextBox x:Name="SearchBox" Height="36" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Text="Buscar…" IsHitTestVisible="False"
                                       Foreground="{StaticResource BrushPlaceholder}"
                                       Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ListBox x:Name="List" Grid.Row="3" Margin="0,8,0,0" SelectionChanged="List_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{StaticResource BrushMuted}" Margin="4,14,0,6" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Kbd}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Trigger}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Trigger}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{StaticResource BrushMuted}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="16" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Panel derecho -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource CardShadow}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <!-- Estado vacío -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Ningún texto seleccionado" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}" HorizontalAlignment="Center" />
                            <TextBlock Text="Elegí un texto de la lista o creá uno nuevo." FontSize="12.5"
                                       Foreground="{StaticResource BrushMuted}" Margin="0,7,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Editor (con scroll si la ventana es baja) -->
                        <ScrollViewer x:Name="EditorScroll" Visibility="Collapsed" Padding="22"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="Editor"
                              MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="EDITAR TEXTO" Style="{StaticResource SectionTitle}" FontSize="12" />
                                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,10,0,2" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="TÍTULO" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TitleBox" Grid.Row="2" Height="36"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CATEGORÍA" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CategoryBox" Height="36"
                                              SelectedItem="{Binding Category, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="" Style="{StaticResource FieldLabel}" />
                                    <CheckBox x:Name="AutoSendCheck" Content="Enviar con Enter automáticamente"
                                              Height="36" VerticalContentAlignment="Center"
                                              IsChecked="{Binding AutoSend}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="4" Text="DISPARADOR (TECLA O COMBINACIÓN)" Style="{StaticResource FieldLabel}" />
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TriggerBox" Grid.Column="0" Height="36" IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Text="{Binding Trigger}"
                                         ToolTip="Hacé clic en «Capturar» y luego apretá la tecla que quieras" />
                                <Button x:Name="CaptureButton" Grid.Column="1" Margin="10,0,0,0"
                                        Click="Capture_Click" MinWidth="150">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoKeyboard}" />
                                        <TextBlock x:Name="CaptureLabel" Text="Capturar tecla" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="ConflictText" Grid.Row="6" Foreground="#FFE0A94B"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed" />

                            <TextBlock Grid.Row="7" Text="ABREVIATURA (OPCIONAL)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AbbrBox" Grid.Row="8" Height="36" FontFamily="Consolas"
                                     Text="{Binding Abbreviation, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="Abbr_TextChanged"
                                     ToolTip="Se expande al tipearla. Conviene un prefijo para evitar disparos accidentales (ej: /saludo)" />

                            <DockPanel Grid.Row="9" Margin="0,14,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="CONTENIDO" Style="{StaticResource FieldLabel}" />
                                <TextBlock DockPanel.Dock="Bottom" Margin="2,6,0,0" FontSize="11"
                                           Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap"
                                           Text="Dinámico: {fecha} {hora} {cursor} · {enter} = dividir en mensajes separados · variables como {nombre}" />
                                <TextBox x:Name="ContentBox" MinHeight="80"
                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Stretch"
                                         VerticalScrollBarVisibility="Auto" Padding="12,10" FontSize="14"
                                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="160">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSave}" />
                                        <TextBlock Text="Guardar cambios" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Barra de estado -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource BrushMuted}"
                   FontSize="12" Margin="2,14,0,0" />
    </Grid>
</Window>
