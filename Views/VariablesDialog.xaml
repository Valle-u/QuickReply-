<Window x:Class="QuickReply.Views.VariablesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Completar datos" Width="420" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Background="{StaticResource BrushBg}">
    <Grid Margin="22" TextElement.Foreground="{StaticResource BrushText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,6"
                   Text="Completá los datos del texto" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FieldsPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" MinWidth="100" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Pegar" MinWidth="120" Margin="0" Style="{StaticResource PrimaryButton}"
                    Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
