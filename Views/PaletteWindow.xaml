<Window x:Class="QuickReply.Views.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickReply" Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="14">
        <Border Style="{StaticResource CardShadow}" />
        <Border Style="{StaticResource Card}" Padding="12">
            <Grid TextElement.Foreground="{StaticResource BrushText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Buscador -->
                <Grid Grid.Row="0">
                    <TextBox x:Name="SearchBox" Height="46" FontSize="17" Padding="14,0"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="Buscar texto…" IsHitTestVisible="False" FontSize="17"
                               Foreground="{StaticResource BrushPlaceholder}"
                               Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Resultados -->
                <ListBox x:Name="List" Grid.Row="1" Margin="0,10,0,0" MaxHeight="360"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="List_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Category}" FontSize="11"
                                               Foreground="{StaticResource BrushMuted}" Margin="0,1,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Kbd}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Trigger}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Trigger}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource BrushMuted}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Ayuda -->
                <TextBlock Grid.Row="2" Margin="4,10,2,2" FontSize="11"
                           Foreground="{StaticResource BrushMuted}"
                           Text="↑ ↓ navegar   ·   Enter pegar   ·   Esc cerrar" />
            </Grid>
        </Border>
    </Grid>
</Window>
