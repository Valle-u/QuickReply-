<Window x:Class="QuickReply.Views.DeleteCategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eliminar categoría" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Background="{StaticResource BrushBg}">
    <Grid Margin="22" TextElement.Foreground="{StaticResource BrushText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Elegí la categoría a eliminar:" FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ComboBox x:Name="CatBox" Grid.Row="1" Height="36" SelectionChanged="CatBox_SelectionChanged" />

        <TextBlock x:Name="InfoText" Grid.Row="2" Foreground="{StaticResource BrushMuted}" FontSize="12"
                   TextWrapping="Wrap" Margin="2,8,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" MinWidth="100" Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="Eliminar" MinWidth="120" Margin="0"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
